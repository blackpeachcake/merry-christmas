{
  "name": "nacho",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "build:web": "pnpm --filter web build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:fe": "pnpm -r --filter web --filter @nacho/shared --if-present run lint",
    "typecheck:fe": "pnpm -r --filter web --filter @nacho/shared --if-present run typecheck",
    "test:fe": "pnpm -r --filter web --filter @nacho/shared --if-present run test",
    "format:check:fe": "prettier --check apps/web .github \"*.{json,yaml,yml,md}\""
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1"
  }
}
