# 로컬 개발용. 복사해서 .env 로 쓰기: cp .env.example .env
# 로컬은 dev DB(아래 docker-compose의 Postgres)를, 리얼(Cloud Run)은 환경변수로 prod DB를 바라봄.
DATABASE_URL=postgresql://nacho:nacho@localhost:5433/nacho_dev?schema=public
PORT=3000

# kakao signup (001) — 실제 값은 .env 에만
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=http://localhost:3000/api/auth/kakao/callback
FE_REDIRECT_URL=http://localhost:5173
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_PENDING_SECRET=

# cloudinary presigned upload (010) — 실제 값은 .env 에만
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
